# Database
MAEILHAM_DB=./data/maeilham.db

# Server
MAEILHAM_HTTP_ADDR=:8080
#MAEILHAM_TZ=Asia/Seoul 
MAEILHAM_BASE_URL=http://localhost:3000
MAEILHAM_API_URL=http://localhost:8080
MAEILHAM_SECRET=change-me

# 콘텐츠 자동 sync 간격 (주석상태면 sync 하지 않음)
#MAEILHAM_SYNC_INTERVAL=1h

# Mail (Resend)
MAEILHAM_RESEND_API_KEY=re_xxxx
MAEILHAM_MAIL_FROM_EMAIL=hello@example.com

# GitHub App (Discussion 생성/수정용)
MAEILHAM_GITHUB_APP_ID=
MAEILHAM_GITHUB_APP_PEM=./data/private-key.pem
MAEILHAM_GITHUB_INSTALLATION_ID=

# GitHub PAT (optional: rate limit 60→5000, private repo 접근)
MAEILHAM_GITHUB_TOKEN=
